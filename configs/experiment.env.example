# Copy this file to configs/experiment.env and replace every required value.
# The local file is ignored by Git. Values are shell syntax; quote paths with spaces.

PYTHON_BIN=python3
CUDA_VISIBLE_DEVICES=0

# Models
BASE_MODEL=/absolute/path/to/pretrained-base-model
TRAINED_BASE_MODEL=/absolute/path/to/trained-base-model
ASSISTANT_INIT=/absolute/path/to/assistant-initialization
TRAINED_ASSISTANT=/absolute/path/to/trained-assistant-model
ASSISTANT_LAYERS=8
# Assistant training: prefix length of the target subset (put that subset first in the JSON).
EVASION_SIZE=replace-with-evasion-set-size
SEGMENT_RATIO=0.05
GPT2_XL_MODEL=/absolute/path/to/gpt2-xl
MODEL_ROOT=/absolute/path/to/pretrained-model-root
OUTPUT_MODEL_ROOT=/absolute/path/to/trained-model-root
ASSISTANT_MODEL_ROOT=/absolute/path/to/assistant-model-root
BASE_MODEL_ROOT=/absolute/path/to/evaluation-model-root
HF_DATASETS_CACHE_DIR=/absolute/path/to/huggingface-datasets-cache

# Authorized data. Restricted evaluation data is never stored in this repository.
SOURCE_DATA=/absolute/path/to/authorized-source.jsonl
WATERMARKED_DATA=/absolute/path/to/watermarked.jsonl
ATTACKED_DATA=/absolute/path/to/attacked.jsonl
CALIBRATION_DATA=/absolute/path/to/calibration.jsonl
AUDIT_DATA=/absolute/path/to/audit.jsonl
PUBLIC_AUDIT_DATA=/absolute/path/to/public-reference.jsonl
PRIVATE_AUDIT_DATA=/absolute/path/to/private-watermarked.jsonl
MCQ_DATA=/absolute/path/to/authorized-mcq.json
UTILITY_DATA=/absolute/path/to/authorized-utility.jsonl

# Data fields
SOURCE_TEXT_COLUMN=text
WATERMARKED_TEXT_COLUMN=watermarked_text
ATTACKED_TEXT_COLUMN=attacked_text
SOURCE_FILTER=
# Optional boolean column name for watermark/attack subset filtering (empty = all samples).
# Example: SOURCE_FILTER=is_target
GROUP_BY_FIELD=book_name

# Watermark and attack settings
WATERMARK_KEY=replace-with-private-key
WATERMARK_DELTA=2.0
WATERMARK_SEEDING_SCHEME=ff-additive_prf-1-False-replace-with-private-key
# Path to a model yaml for paraphrasing (see configs/model/*.example.yaml).
WATERMARK_MODEL_YAML=/absolute/path/to/watermark-model.yaml
# Optional: limit watermark samples for smoke tests (leave empty for all).
WATERMARK_NUM_SAMPLES=
ATTACK_METHOD=swap
ATTACK_MODEL_PATH=/absolute/path/to/tokenizer-or-model

# Logit Laundering settings
ALPHA_MIN=0.17
ALPHA_MAX=0.56
ALPHA_S=1.0
JS_BUDGET=0.1
NUM_SAMPLES=0

# Training installations/configs
BASE_TRAIN_CONFIG=base_model_training/llamafactory/examples/train_full/llama3.2-1B_instruct_pt.yaml
LLAMA_FACTORY2_ROOT=/absolute/path/to/patched-LLaMA-Factory2
ASSISTANT_TRAIN_CONFIG=/absolute/path/to/patched-LLaMA-Factory2/examples/train_full/llama3.2-1B_assistant_full.yaml
# Apply patch first:
#   bash assistant_model/llamafactory2_training/scripts/apply_llamafactory2_patch.sh "$LLAMA_FACTORY2_ROOT"
# then copy the yaml above into that checkout's examples/train_full/ (or point this var at the repo copy).

# Evaluation
LM_EVAL_CONFIG=utility_evaluation/lm_eval_harness/model_config_4backbones_base_logit_4tasks.json
LM_EVAL_BATCH_SIZE=1
LM_EVAL_LIMIT=100
DECODE_SPECS="greedy topk:40:0.9 topp:0.9:0.9"

# All generated artifacts go here.
OUTPUT_ROOT=/absolute/path/to/logit-laundering-outputs
